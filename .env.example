DJANGO_SECRET_KEY=change-me-in-development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver,*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
FRONTEND_URL=http://localhost:5173/

# Neon PostgreSQL Database (Single Connection String)
DATABASE_URL=postgresql://username:password@ep-cool-cloud-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Or Local PostgreSQL (Separate parameters fallback)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=hoteldb
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Apache Kafka
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_CONSUMER_GROUP=quickstay-consumer-group

# Cashfree Payments API (Sandbox / Production)
CASHFREE_APP_ID=TEST1000000000000000000000000000
CASHFREE_SECRET_KEY=TEST_SECRET_KEY_SAMPLE
CASHFREE_API_VERSION=2023-08-01
CASHFREE_ENVIRONMENT=SANDBOX

# Email Notifications (SMTP / Console)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@quickstay.local


